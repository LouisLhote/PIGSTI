# PIGSTI Configuration Template

# Database Configuration
kraken_db: "/path/to/krakenuniq/database"
host_index: "/path/to/host/bwa/index"

# BWA Indices for Different Host Species
bwa_indices:
  "Homo sapiens": "/path/to/human/genome/bwa/index"
  "Sus scrofa": "/path/to/pig/genome/bwa/index"
  "Bos taurus": "/path/to/cow/genome/bwa/index"
  "Equus caballus": "/path/to/horse/genome/bwa/index"
  "Canis lupus": "/path/to/dog/genome/bwa/index"
  "Felis catus": "/path/to/cat/genome/bwa/index"

# Mitochondrial DNA Indices
mtDNA_indices:
  "Homo sapiens": "/path/to/human/mtdna/bwa/index"
  "Sus scrofa": "/path/to/pig/mtdna/bwa/index"
  "Bos taurus": "/path/to/cow/mtdna/bwa/index"
  "Equus caballus": "/path/to/horse/mtdna/bwa/index"
  "Canis lupus": "/path/to/dog/mtdna/bwa/index"
  "Felis catus": "/path/to/cat/mtdna/bwa/index"

# Analysis Parameters
min_read_length: 30
quality_threshold: 30
min_adapter_overlap: 1

# Adapter Sequences
adapter1: "AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC"
adapter2: "AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"


# Pathogen Detection Thresholds
escore_threshold: 2.0
hops_threshold: 0.01
bwa_min_coverage: 0.1

# Output Configuration
output_format: "html"
include_intermediate_files: false
compress_outputs: true

# Logging Configuration
log_level: "INFO"
keep_logs: true
log_retention_days: 30

# decOM Configuration (for microbiome analysis)
decOM_sources: "/path/to/decOM/sources"

# Quality Control Parameters
fastq_screen_conf: "/path/to/fastq_screen.conf"
prinseq_min_length: 30
prinseq_min_quality: 20

# DamageProfiler Parameters
damageprofiler_min_length: 30
damageprofiler_max_length: 1000

# QualiMap Parameters
qualimap_java_mem: "9G"
qualimap_min_coverage: 1

# Advanced Options
enable_soft_clipping: true
enable_entropy_analysis: true
enable_damage_analysis: true
enable_comparative_analysis: true


